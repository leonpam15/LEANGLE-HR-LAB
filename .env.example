# LEANGLE HR LAB — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to GitHub.
# ─────────────────────────────────────────────────────────

# Stripe (get from stripe.com → Developers → API Keys)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PRICE_ID=price_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Resend (get from resend.com → API Keys)
RESEND_API_KEY=re_REPLACE_ME

# Anthropic (get from console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Your site URL (use http://localhost:3000 for local dev)
NEXT_PUBLIC_URL=http://localhost:3000
